{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:addon-manager:addon-migration:1",
  "title": "Addon Manager additive addon-owned migration",
  "type": "object", "additionalProperties": false, "required": ["operations"],
  "properties": {"operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["type", "table", "columns"], "properties": {"type": {"const": "createTable"}, "table": {"$ref": "#/$defs/identifier"}, "columns": {"$ref": "#/$defs/columns"}, "primary": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "table", "columns"], "properties": {"type": {"const": "addColumns"}, "table": {"$ref": "#/$defs/identifier"}, "columns": {"allOf": [{"$ref": "#/$defs/columns"}, {"items": {"anyOf": [{"required": ["nullable"], "properties": {"nullable": {"const": true}}}, {"required": ["default"], "properties": {"default": {"not": {"type": "null"}}}}]}}], "description": "New columns must allow NULL or have a valid non-null default so old code can still insert rows."}}},
    {"type": "object", "additionalProperties": false, "required": ["type", "table", "name", "columns"], "properties": {"type": {"const": "createIndex"}, "table": {"$ref": "#/$defs/identifier"}, "name": {"$ref": "#/$defs/identifier"}, "columns": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}, "unique": {"const": false, "description": "New unique constraints can reject writes by a rolled-back addon version and are unsupported in v1."}}}
  ]}}},
  "$defs": {
    "identifier": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$", "description": "Table names must also start with the addon ID with dots/hyphens replaced by underscores, followed by underscore."},
    "columns": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["string", "text", "integer", "bigInteger", "boolean", "timestamp", "json"]}, "nullable": {"type": "boolean"}, "length": {"type": "integer", "minimum": 1, "maximum": 1024}, "default": {"type": ["string", "integer", "boolean", "null"]}}, "allOf": [
      {"if": {"required": ["length"]}, "then": {"properties": {"type": {"const": "string"}}}},
      {"if": {"required": ["default"], "properties": {"default": {"type": "null"}}}, "then": {"required": ["nullable"], "properties": {"nullable": {"const": true}}}},
      {"if": {"properties": {"type": {"const": "string"}}}, "then": {"properties": {"default": {"type": ["string", "null"], "maxLength": 1024}}}},
      {"if": {"properties": {"type": {"enum": ["integer", "bigInteger"]}}}, "then": {"properties": {"default": {"type": ["integer", "null"]}}}},
      {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": ["boolean", "null"]}}}},
      {"if": {"properties": {"type": {"enum": ["text", "timestamp", "json"]}}}, "then": {"properties": {"default": {"type": "null"}}}}
    ]}}
  }
}
