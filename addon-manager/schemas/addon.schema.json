{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:addon-manager:addon-manifest:1",
  "title": "Addon Manager addon manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "version", "compatibility"],
  "properties": {
    "manifestVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "version": {"$ref": "#/$defs/version"},
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["manager", "php", "panel"],
      "properties": {"manager": {"$ref": "#/$defs/constraint"}, "php": {"$ref": "#/$defs/constraint"}, "panel": {"$ref": "#/$defs/constraint"}, "arix": {"$ref": "#/$defs/constraint"}, "addonPack": {"$ref": "#/$defs/constraint"}}
    },
    "dependencies": {"type": "array", "maxItems": 1000, "default": [], "items": {"$ref": "#/$defs/relationship"}},
    "incompatible": {"type": "array", "maxItems": 1000, "default": [], "items": {"$ref": "#/$defs/relationship"}},
    "files": {"type": "array", "maxItems": 1000, "default": [], "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "target", "sha256"],
      "properties": {"source": {"$ref": "#/$defs/path"}, "target": {"$ref": "#/$defs/target"}, "sha256": {"$ref": "#/$defs/hash"}}
    }},
    "patches": {"type": "array", "maxItems": 1000, "default": [], "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "target", "owner", "find", "replace", "beforeSha256", "afterSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/target"},
        "owner": {"type": "string", "pattern": "^(panel|arix|baseline|addon:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*)$", "maxLength": 140},
        "find": {"$ref": "#/$defs/path"}, "replace": {"$ref": "#/$defs/path"},
        "beforeSha256": {"$ref": "#/$defs/hash", "description": "SHA-256 of exact nonempty UTF-8 find fragment bytes."},
        "afterSha256": {"$ref": "#/$defs/hash", "description": "SHA-256 of exact UTF-8 replacement fragment bytes; replacement may be empty."}
      }
    }},
    "extensions": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "pages": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "path", "title", "view", "permission"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/endpoint"}, "title": {"type": "string", "minLength": 1, "maxLength": 120}, "view": {"type": "string", "maxLength": 200, "pattern": "^addons\\.[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$"}, "permission": {"const": "admin"}}
        }},
        "routes": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "path", "method", "handler", "permission"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/endpoint"}, "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "handler": {"$ref": "#/$defs/handler"}, "permission": {"const": "admin"}}
        }},
        "menus": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label", "page"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 100}, "page": {"$ref": "#/$defs/id"}}
        }},
        "events": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "event", "handler", "permission"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "event": {"type": "string", "maxLength": 220, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)+$"}, "handler": {"$ref": "#/$defs/handler"}, "permission": {"const": "system"}}
        }},
        "jobs": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "handler", "permission"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "handler": {"$ref": "#/$defs/handler"}, "permission": {"const": "system"}}
        }},
        "schedules": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "handler", "frequency", "permission"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "handler": {"$ref": "#/$defs/handler"}, "frequency": {"enum": ["everyMinute", "hourly", "daily"]}, "permission": {"const": "system"}}
        }}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false, "default": {"dataPolicy": "preserve", "migrations": []},
      "properties": {
        "dataPolicy": {"const": "preserve", "default": "preserve"},
        "migrations": {"type": "array", "maxItems": 100, "default": [], "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "source", "sha256"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.json$"}]}, "sha256": {"$ref": "#/$defs/hash"}}
        }}
      }
    },
    "build": {
      "default": {"mode": "none"},
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "none"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "profile", "outputs"], "properties": {"mode": {"const": "panel"}, "profile": {"const": "panel-v1"}, "outputs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"allOf": [{"$ref": "#/$defs/target"}, {"pattern": "^public/assets(?:/|$)"}]}}}}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 100, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "constraint": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[0-9A-Za-z.*+^~<>=!|, -]+$", "description": "Validated semver range: exact/partial versions, *, x, ^, ~, comparisons, whitespace/comma AND, || OR, or hyphen ranges. PHP validation rejects unsupported syntax."},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*(?:^|/)(?:\\.{1,2}|CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.|/|$))(?!.*\\.(?:/|$))[A-Za-z0-9_@+.-]+(?:/[A-Za-z0-9_@+.-]+)*$", "description": "Portable relative path; no symlinks, absolute paths, traversal, control characters, backslashes, drive letters, percent escapes or Windows reserved names. Runtime checks also reject case collisions."},
    "target": {"allOf": [{"$ref": "#/$defs/path"}, {"not": {"pattern": "(?:^|/)(?:\\.(?:[Dd][Oo][Cc][Kk][Ee][Rr]|[Gg][Nn][Uu][Pp][Gg]|[Kk][Uu][Bb][Ee]|[Aa][Zz][Uu][Rr][Ee]|[Nn][Ee][Tt][Rr][Cc])|_[Nn][Ee][Tt][Rr][Cc])(?:/|$)|\\.(?:[Pp][Ee][Mm]|[Kk][Ee][Yy]|[Pp]12|[Pp][Ff][Xx])(?:/|$)"}}, {"not": {"pattern": "(?:^|/)\\.(?:[Hh][Tt][Aa][Cc][Cc][Ee][Ss][Ss]|[Uu][Ss][Ee][Rr]\\.[Ii][Nn][Ii])(?:/|$)"}}, {"not": {"pattern": "(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|vendor(?:/|$)|node_modules(?:/|$)|addon-manager(?:/|$))|^(?:storage|addons|arix|bootstrap/cache)(?:/|$)|^public/.*\\.(?:php[0-9]?|phtml|phar)(?:\\.|$)"}}, {"not": {"anyOf": [{"pattern": "^app/Http/(?:Controllers/Admin/Arix|Middleware/Admin/Arix)(?:/|$)"}, {"enum": ["app/Http/Controllers/Auth/ArixController.php", "app/Helpers/ArixAddons.php", "config/arix.php", "config/arixTheme.php", "config/pluginsAddon.php", "routes/admin.php", "routes/auth.php", "app/Http/Middleware/AdminAuthenticate.php", "app/Http/Middleware/RequireTwoFactorAuthentication.php", "app/Http/Middleware/VerifyCsrfToken.php"]}]}}], "description": "Host-relative destination. Credential stores and key/certificate containers, per-directory Apache/PHP configuration (.htaccess/.user.ini), manager root-admin/two-factor/CSRF middleware and Arix licensing internals are protected. Runtime validation case-folds all protections and additionally protects manager/bootstrap registrations, credentials and dependency/build configuration."},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/constraint"}}},
    "endpoint": {"type": "string", "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9_-]*(?:/[a-z0-9_-]+)*$"},
    "handler": {"type": "string", "maxLength": 220, "pattern": "^Pterodactyl\\\\Addons\\\\[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*@(?!(?:__))[A-Za-z_][A-Za-z0-9_]*$", "description": "Class must map to a declared app/Addons PHP file."}
  }
}
